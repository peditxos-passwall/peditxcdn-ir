                        </p>
                    </div>

                    <!-- Action Button -->
                    <a href="https://docproir.peditxcdn.ir:8443" class="group relative inline-flex items-center justify-center gap-3 px-10 py-5 bg-gradient-to-r from-[var(--secondary)] to-purple-700 rounded-2xl text-white font-bold text-lg shadow-[0_0_30px_rgba(112,0,255,0.3)] hover:shadow-[0_0_50px_rgba(112,0,255,0.5)] transition-all duration-300 transform hover:-translate-y-1 overflow-hidden">
                        <div class="absolute inset-0 bg-white/20 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700 ease-in-out skew-x-12"></div>
                        <i class="fas fa-external-link-alt text-xl group-hover:scale-110 transition-transform duration-300"></i>
                        <span>ورود به پنل کاربری</span>
                    </a>

                    <!-- Secure Note -->
                    <div class="flex items-center gap-2 text-sm text-gray-500 mt-2">
                        <i class="fas fa-shield-alt text-[var(--success)]"></i>
                        <span>پرداخت مستقیم با کارت بانکی</span>
                    </div>
                </div>
            </section>

            <!-- REPO, COMPILE & STORE CTA -->
            <section id="repository-section" class="py-20 px-6 bg-gradient-to-t from-black/40 to-transparent">
                <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                    <!-- Repo Card -->
