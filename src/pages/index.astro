    <meta property="og:title" content="PeDitXCDN - Hack, Build, Reign">
    <meta property="og:description" content="PeDitXCDN is an OpenWrt-based OS that simplifies router management.">
    <meta property="og:image" content="https://dns-gaming.ir/fav/apple-touch-icon.png">
    <meta property="og:locale" content="fa_IR" id="meta-og-locale">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://dns-gaming.ir/">
    <meta property="twitter:title" content="PeDitXCDN - Hack, Build, Reign">
    <meta property="twitter:description" content="PeDitXCDN is an OpenWrt-based OS that simplifies router management.">
    <meta property="twitter:image" content="https://dns-gaming.ir/fav/apple-touch-icon.png">

    <!-- Structured Data (JSON-LD) for Rich Snippets in Google -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "PeDitXCDN",
      "operatingSystem": "OpenWrt",
      "applicationCategory": "UtilitiesApplication",
      "description": "PeDitXCDN is an OpenWrt-based OS that simplifies router management with powerful tools like easy Passwall installation and a beautiful graphical interface.",
      "url": "https://dns-gaming.ir/",
      "author": {
        "@type": "Organization",
        "name": "PeDitXCDN Project"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
    </script>

    <link rel="icon" href="/fav/favicon.ico" sizes="any">

    <!-- Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;700;900&family=Vazirmatn:wght@300;500;700;900&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Particles -->
    <script is:inline src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>

    <style is:global>
        /* --- MODERN THEME VARIABLES --- */
        :root {
            --bg-deep: #050505;
            --surface: #0f0f13;
            --surface-lighter: #1a1a24;
            --primary: #00f0ff;
            --secondary: #7000ff;
            --success: #00ff9d;
            --danger: #ff0055;
            --text-main: #ffffff;
            --text-muted: #888899;
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            font-family: 'Vazirmatn', 'Outfit', sans-serif;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        /* Background Mesh Gradient */
        .ambient-light {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background:
                radial-gradient(circle at 15% 20%, rgba(112, 0, 255, 0.1), transparent 40%),
                radial-gradient(circle at 85% 80%, rgba(0, 240, 255, 0.1), transparent 40%);
            z-index: -1;
            pointer-events: none;
        }

        /* --- MODERN COMPONENTS --- */

        /* Main App Container */
        .app-shell {
            background: rgba(15, 15, 19, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.7);
            border-radius: 32px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Buttons */
        .btn-primary {
            background: linear-gradient(135deg, var(--secondary), #5200cc);
            color: white;
            font-weight: 700;
            border-radius: 12px;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(112, 0, 255, 0.4);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(112, 0, 255, 0.6);
        }

        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .btn-glass:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--primary);
            color: var(--primary);
        }

        /* Store Specific Button */
        .btn-success-glass {
            background: rgba(0, 255, 157, 0.05);
            border: 1px solid rgba(0, 255, 157, 0.2);
            color: var(--success);
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .btn-success-glass:hover {
            background: rgba(0, 255, 157, 0.15);
            border-color: var(--success);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 255, 157, 0.3);
        }

        /* Repo Specific Button */
        .btn-primary-glass {
            background: rgba(0, 240, 255, 0.05);
            border: 1px solid rgba(0, 240, 255, 0.2);
            color: var(--primary);
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .btn-primary-glass:hover {
            background: rgba(0, 240, 255, 0.15);
            border-color: var(--primary);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 240, 255, 0.3);
        }

        /* Feature Cards */
        .feature-card {
            background: var(--surface-lighter);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 2rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .feature-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 240, 255, 0.3);
            background: rgba(26, 26, 36, 0.8);
        }
        .feature-card i {
            background: -webkit-linear-gradient(45deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Modern Select */
        .modern-select {
            appearance: none;
            background-color: var(--surface-lighter);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 6px 12px;
            font-size: 0.85rem;
            outline: none;
            cursor: pointer;
            backdrop-filter: blur(10px);
        }
        .modern-select option { background: var(--surface-lighter); color: white; padding: 10px; }

        /* Nav Links */
        .nav-link {
            position: relative;
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.3s;
        }
        .nav-link:hover { color: white; }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 50%;
            width: 0;
            height: 2px;
            background: var(--primary);
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }
        .nav-link:hover::after { width: 100%; }

        /* Animations */
        @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-10px); } 100% { transform: translateY(0px); } }
        .floating-logo { animation: float 6s ease-in-out infinite; }

        /* Target Highlight Animations */
        #tutorial-card:target {
            animation: highlight-compile 1.5s ease-out;
        }
        #store-card:target {
            animation: highlight-store 1.5s ease-out;
        }
        #repo-card:target {
            animation: highlight-repo 1.5s ease-out;
        }
        @keyframes highlight-compile {
            0% { border-color: var(--secondary); transform: translateY(-15px); box-shadow: 0 15px 40px rgba(112, 0, 255, 0.4); background: rgba(26, 26, 36, 0.9); }
            100% { border-color: rgba(255,255,255,0.05); transform: translateY(0); box-shadow: none; background: var(--surface-lighter); }
        }
        @keyframes highlight-store {
            0% { border-color: var(--success); transform: translateY(-15px); box-shadow: 0 15px 40px rgba(0, 255, 157, 0.4); background: rgba(26, 26, 36, 0.9); }
            100% { border-color: rgba(255,255,255,0.05); transform: translateY(0); box-shadow: none; background: var(--surface-lighter); }
        }
        @keyframes highlight-repo {
            0% { border-color: var(--primary); transform: translateY(-15px); box-shadow: 0 15px 40px rgba(0, 240, 255, 0.4); background: rgba(26, 26, 36, 0.9); }
            100% { border-color: rgba(255,255,255,0.05); transform: translateY(0); box-shadow: none; background: var(--surface-lighter); }
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }

        /* Tutorial Tabs */
        .tutorial-tab { background: rgba(255,255,255,0.05); color: #9ca3af; }
        .tutorial-tab.active-tab { background: var(--secondary); color: #fff; box-shadow: 0 0 20px rgba(112,0,255,0.4); }
        .tutorial-tab:hover:not(.active-tab) { background: rgba(255,255,255,0.1); color: #fff; }

        /* Pricing Tabs */
        .pricing-tab { background: rgba(255,255,255,0.05); color: #9ca3af; }
        .pricing-tab.active-tab { background: var(--primary); color: #fff; box-shadow: 0 0 20px rgba(0,240,255,0.4); }
        .pricing-tab:hover:not(.active-tab) { background: rgba(255,255,255,0.1); color: #fff; }

        /* Mobile */
        @media (max-width: 1024px) {
            .app-shell { border-radius: 0; height: 100dvh; max-width: 100%; border: none; }
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-0 lg:p-6">

    <div class="ambient-light"></div>
    <div id="particles-js" class="fixed inset-0 pointer-events-none z-0 opacity-30"></div>

    <!-- MAIN APP SHELL -->
    <div id="main-interface" class="app-shell w-full max-w-[1280px] h-full lg:h-[90vh] flex flex-col relative z-10">

        <!-- HEADER -->
        <header class="flex justify-between items-center p-5 border-b border-white/5 bg-white/[0.02] backdrop-blur-md sticky top-0 z-50">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl overflow-hidden shadow-lg shadow-purple-500/20 floating-logo bg-black">
                    <img src="/fav/apple-touch-icon.png" class="w-full h-full object-cover opacity-90" onerror="this.src='https://placehold.co/40x40/000000/FFFFFF?text=D'" alt="Logo">
                </div>
                <div class="leading-tight hidden sm:block">
                    <h1 class="text-xl font-bold font-['Outfit'] tracking-wider text-white">PeDitX<span class="text-[var(--primary)]">CDN</span></h1>
                </div>
            </div>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center gap-8">
                <a href="#hero" class="nav-link">صفحه اصلی</a>
                <a href="#features" class="nav-link">چرا CDN/DNS ما؟</a>
                <a href="#install" class="nav-link">پنل کاربری</a>
                <a href="#repo-card" class="nav-link">تعرفه‌ها</a>
                <a href="#tutorial-card" class="nav-link">آموزش</a>
                <a href="#store-card" class="nav-link">خرید اشتراک</a>
            </nav>

            <div class="flex items-center gap-3">
                <a href="https://t.me/peditx" class="text-[var(--primary)] text-2xl hover:scale-110 transition-transform">
                    <i class="fab fa-telegram"></i>
                </a>

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-btn" class="md:hidden text-white p-2">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </header>

        <!-- MOBILE MENU OVERLAY (Backdrop) -->
        <div id="mobile-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"></div>

        <!-- MOBILE MENU SIDEBAR -->
        <div id="mobile-menu" class="absolute top-0 bottom-0 right-0 w-[280px] max-w-[80vw] bg-[var(--surface-lighter)] border-l border-white/5 z-[70] transform translate-x-full transition-transform duration-300 md:hidden flex flex-col shadow-2xl overflow-y-auto">

            <!-- Sidebar Header -->
            <div class="flex justify-between items-center p-6 border-b border-white/5">
                <span class="text-xl font-bold font-['Outfit'] text-white tracking-wider">PeDitX<span class="text-[var(--primary)]">CDN</span></span>
                <button id="close-menu-btn" class="text-gray-400 hover:text-white text-2xl transition-colors w-8 h-8 flex items-center justify-center rounded-full bg-white/5 hover:bg-white/10">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Sidebar Links -->
            <div class="flex flex-col p-6 gap-2">
                <a href="#hero" class="py-3 px-4 rounded-xl text-base font-medium text-gray-300 hover:text-white hover:bg-white/5 transition-all mobile-link">صفحه اصلی</a>
                <a href="#features" class="py-3 px-4 rounded-xl text-base font-medium text-gray-300 hover:text-white hover:bg-white/5 transition-all mobile-link">چرا CDN/DNS ما؟</a>
                <a href="#install" class="py-3 px-4 rounded-xl text-base font-medium text-gray-300 hover:text-white hover:bg-white/5 transition-all mobile-link">پنل کاربری</a>
                <a href="#repo-card" class="py-3 px-4 rounded-xl text-base font-medium text-gray-300 hover:text-white hover:bg-white/5 transition-all mobile-link">تعرفه‌ها</a>

                <div class="h-px bg-white/5 my-2"></div>

                <a href="#tutorial-card" class="py-3 px-4 rounded-xl text-base font-bold text-[var(--primary)] hover:bg-[var(--primary)]/10 transition-all mobile-link flex items-center gap-3">
                    <i class="fas fa-cogs"></i> <span>آموزش</span>
                </a>
                <a href="#store-card" class="py-3 px-4 rounded-xl text-base font-bold text-[var(--success)] hover:bg-[var(--success)]/10 transition-all mobile-link flex items-center gap-3">
                    <i class="fas fa-store"></i> <span>خرید اشتراک</span>
                </a>
            </div>

            <!-- Sidebar Footer -->
            <div class="mt-auto p-6 border-t border-white/5">
                <p class="text-xs text-center text-gray-500 font-mono">PeDitXCDN</p>
            </div>
        </div>

        <!-- SCROLLABLE CONTENT -->
        <div class="flex-1 overflow-y-auto custom-scrollbar scroll-smooth">

            <!-- HERO SECTION -->
            <section id="hero" class="min-h-[80vh] flex flex-col justify-center items-center text-center px-6 relative">
                <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[var(--bg-deep)] opacity-80 pointer-events-none"></div>

                <span class="inline-block py-1 px-3 rounded-full bg-white/5 border border-white/10 text-[10px] tracking-[0.2em] font-bold text-[var(--primary)] mb-6 animate-pulse">NEXT GEN DNS</span>

                <h1 class="text-5xl md:text-7xl font-black font-['Outfit'] mb-6 leading-tight">
                    <span class="text-white">HACK.</span> <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--primary)] to-[var(--secondary)]">BUILD.</span> <span class="text-white">GAME.</span>
                </h1>

                <p class="text-gray-400 text-lg md:text-xl max-w-2xl mb-10 leading-relaxed">
                    یک روش ساده برای رفع تحریم. برای تمام دستگاه‌ها PC / Console / Router / Modem / Mobile
                </p>

                <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-4 w-full sm:w-auto z-10">
                    <a href="#install" class="btn-primary py-4 px-8 text-sm uppercase tracking-widest flex items-center justify-center gap-2">
                        <i class="fas fa-download"></i> <span>پنل کاربری</span>
                    </a>
                    <a href="#tutorial-card" class="btn-glass py-4 px-8 text-sm uppercase tracking-widest flex items-center justify-center gap-2">
                        <i class="fas fa-hammer"></i> <span>آموزش استفاده</span>
                    </a>
                    <a href="#store-card" class="btn-success-glass py-4 px-8 text-sm uppercase tracking-widest flex items-center justify-center gap-2">
                        <i class="fas fa-store"></i> <span>خرید و تمدید اشتراک</span>
                    </a>
                </div>
            </section>

            <!-- FEATURES GRID -->
            <section id="features" class="py-20 px-6 md:px-12 bg-black/20">
                <div class="max-w-6xl mx-auto">
                    <div class="text-center mb-16">
                        <h2 class="text-3xl font-bold text-white mb-2">چرا CDN/DNS ما؟</h2>
                        <div class="h-1 w-20 bg-[var(--primary)] mx-auto rounded-full"></div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div class="feature-card">
                            <i class="fas fa-shield-alt text-4xl mb-4 block"></i>
                            <h3 class="text-lg font-bold text-white mb-2">رفع تحریم</h3>
                            <p class="text-sm text-gray-400 leading-relaxed">دسترسی آزاد و بدون محدودیت به تمام سرویس‌ها و محتواهای اینترنتی.</p>
                        </div>
                        <div class="feature-card">
                            <i class="fas fa-gamepad text-4xl mb-4 block"></i>
                            <h3 class="text-lg font-bold text-white mb-2">گیمینگ</h3>
                            <p class="text-sm text-gray-400 leading-relaxed">پوشش دهی حداکثری بازی‌ها با پینگ پایین و سرعت بالا.</p>
                        </div>
                        <div class="feature-card">
                            <i class="fas fa-robot text-4xl mb-4 block"></i>
                            <h3 class="text-lg font-bold text-white mb-2">نرم‌افزار و هوش مصنوعی</h3>
                            <p class="text-sm text-gray-400 leading-relaxed">پوشش دهی حداکثری اپلیکیشن‌ها و سرویس‌ها با اتصال هوشمند.</p>
                        </div>
                        <div class="feature-card">
                            <i class="fas fa-headset text-4xl mb-4 block"></i>
                            <h3 class="text-lg font-bold text-white mb-2">پشتیبانی ۲۴/۷</h3>
                            <p class="text-sm text-gray-400 leading-relaxed">تیم پشتیبانی ما در تمام ساعات شبانه روز آماده کمک به شماست.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- INSTALL SECTION -->
