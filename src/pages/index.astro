                    <p class="text-gray-500 text-xs mt-3"><i class="fas fa-info-circle ml-1"></i> تنظیمات بسته به مدل مودم ممکن است کمی متفاوت باشد.</p>
                </div>
            </div>

            <button id="close-tutorial-modal-btn" class="mt-5 w-full py-3 px-6 text-sm font-bold rounded-xl bg-[var(--secondary)]/10 border border-[var(--secondary)]/30 text-[var(--secondary)] hover:bg-[var(--secondary)]/20 transition cursor-pointer">
                <i class="fas fa-times ml-1"></i> بستن
            </button>
        </div>
    </div>

    <!-- Pricing Modal -->
    <div id="pricing-modal" class="fixed inset-0 z-[200] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="pricing-modal-overlay"></div>
        <div class="relative bg-[var(--surface)] border border-white/10 rounded-2xl p-6 max-w-lg w-full max-h-[85vh] overflow-y-auto shadow-2xl transform scale-95 transition-transform duration-300" id="pricing-modal-content">
            <button id="close-pricing-modal" class="absolute top-4 left-4 text-gray-400 hover:text-white transition text-xl cursor-pointer z-10">
                <i class="fas fa-times"></i>
            </button>
            <div class="text-center mb-5">
                <div class="w-16 h-16 rounded-full bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)] text-2xl mx-auto mb-4">
                    <i class="fas fa-tags"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-1">تعرفه‌های سرویس</h3>
                <p class="text-gray-400 text-xs">پلن مورد نظر خود را انتخاب کنید</p>
            </div>

            <!-- Plan Tabs -->
            <div class="flex gap-2 justify-center mb-5">
                <button class="pricing-tab active-tab text-xs font-bold px-4 py-2 rounded-lg transition cursor-pointer" data-plan="bronze">برنزی</button>
                <button class="pricing-tab text-xs font-bold px-4 py-2 rounded-lg transition cursor-pointer" data-plan="gold">گلد</button>
                <button class="pricing-tab text-xs font-bold px-4 py-2 rounded-lg transition cursor-pointer" data-plan="platinum">پلاتینیوم</button>
                <button class="pricing-tab text-xs font-bold px-4 py-2 rounded-lg transition cursor-pointer" data-plan="master">مستر</button>
            </div>

            <!-- Bronze Plan -->
            <div class="pricing-content" data-plan="bronze">
                <div class="bg-[var(--surface-lighter)] border border-[var(--primary)]/20 rounded-xl p-6">
                    <div class="text-center mb-4">
                        <span class="inline-block px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold mb-2">برنزی</span>
                        <div class="text-3xl font-bold text-white">۴۰۰,۰۰۰ <span class="text-sm text-gray-400 font-normal">تومان</span></div>
                        <div class="text-gray-400 text-xs mt-1">ماهانه</div>
                    </div>
                    <ul class="text-gray-300 text-xs space-y-3 mb-5">
                        <li class="flex items-center gap-2"><i class="fas fa-check text-[var(--primary)] text-[10px]"></i> ۲۰ گیگابایت ترافیک ماهانه</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-[var(--primary)] text-[10px]"></i> رفع تحریم کامل</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-[var(--primary)] text-[10px]"></i> اتصال نامحدود در ۱ شبکه</li>
                    </ul>
                    <button class="btn-buy-plan w-full py-3 px-6 text-sm font-bold rounded-xl bg-[var(--primary)]/10 border border-[var(--primary)]/30 text-[var(--primary)] hover:bg-[var(--primary)]/20 transition cursor-pointer">
                        <i class="fas fa-shopping-cart ml-1"></i> خرید این پلن
                    </button>
                </div>
            </div>

            <!-- Gold Plan -->
            <div class="pricing-content hidden" data-plan="gold">
                <div class="bg-[var(--surface-lighter)] border border-yellow-500/20 rounded-xl p-6 relative overflow-hidden">
                    <div class="absolute top-3 left-3 bg-yellow-500/20 text-yellow-300 text-[10px] font-bold px-2 py-0.5 rounded-full">ویژه</div>
                    <div class="text-center mb-4">
                        <span class="inline-block px-3 py-1 rounded-full bg-yellow-500/10 text-yellow-400 text-xs font-bold mb-2">گلد</span>
                        <div class="text-3xl font-bold text-white">۶۵۰,۰۰۰ <span class="text-sm text-gray-400 font-normal">تومان</span></div>
                        <div class="text-gray-400 text-xs mt-1">ماهانه</div>
                    </div>
                    <ul class="text-gray-300 text-xs space-y-3 mb-5">
                        <li class="flex items-center gap-2"><i class="fas fa-check text-yellow-400 text-[10px]"></i> ۵۰ گیگابایت ترافیک ماهانه</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-yellow-400 text-[10px]"></i> رفع تحریم کامل</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-yellow-400 text-[10px]"></i> اتصال نامحدود در ۱ شبکه</li>
                    </ul>
                    <button class="btn-buy-plan w-full py-3 px-6 text-sm font-bold rounded-xl bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 hover:bg-yellow-500/20 transition cursor-pointer">
                        <i class="fas fa-shopping-cart ml-1"></i> خرید این پلن
                    </button>
                </div>
            </div>

            <!-- Platinum Plan -->
            <div class="pricing-content hidden" data-plan="platinum">
                <div class="bg-[var(--surface-lighter)] border border-gray-300/20 rounded-xl p-6">
                    <div class="text-center mb-4">
                        <span class="inline-block px-3 py-1 rounded-full bg-gray-300/10 text-gray-300 text-xs font-bold mb-2">پلاتینیوم</span>
                        <div class="text-3xl font-bold text-white">۱,۰۰۰,۰۰۰ <span class="text-sm text-gray-400 font-normal">تومان</span></div>
                        <div class="text-gray-400 text-xs mt-1">ماهانه</div>
                    </div>
                    <ul class="text-gray-300 text-xs space-y-3 mb-5">
                        <li class="flex items-center gap-2"><i class="fas fa-check text-gray-300 text-[10px]"></i> ۱۰۰ گیگابایت ترافیک ماهانه</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-gray-300 text-[10px]"></i> رفع تحریم کامل</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-gray-300 text-[10px]"></i> اتصال نامحدود در ۱ شبکه</li>
                    </ul>
                    <button class="btn-buy-plan w-full py-3 px-6 text-sm font-bold rounded-xl bg-gray-300/10 border border-gray-300/30 text-gray-300 hover:bg-gray-300/20 transition cursor-pointer">
                        <i class="fas fa-shopping-cart ml-1"></i> خرید این پلن
                    </button>
                </div>
            </div>

            <!-- Master Plan -->
            <div class="pricing-content hidden" data-plan="master">
                <div class="bg-[var(--surface-lighter)] border border-purple-500/20 rounded-xl p-6 relative overflow-hidden">
                    <div class="absolute top-3 left-3 bg-purple-500/20 text-purple-300 text-[10px] font-bold px-2 py-0.5 rounded-full">ویژه</div>
                    <div class="text-center mb-4">
                        <span class="inline-block px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 text-xs font-bold mb-2">مستر</span>
                        <div class="text-3xl font-bold text-white">۲,۴۰۰,۰۰۰ <span class="text-sm text-gray-400 font-normal">تومان</span></div>
                        <div class="text-gray-400 text-xs mt-1">۳ ماهه</div>
                    </div>
                    <ul class="text-gray-300 text-xs space-y-3 mb-5">
                        <li class="flex items-center gap-2"><i class="fas fa-check text-purple-400 text-[10px]"></i> ترافیک <b class="text-white">نامحدود</b></li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-purple-400 text-[10px]"></i> رفع تحریم کامل</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-purple-400 text-[10px]"></i> اتصال نامحدود در ۱ شبکه</li>
                        <li class="flex items-center gap-2"><i class="fas fa-check text-purple-400 text-[10px]"></i> اولویت اتصال</li>
                    </ul>
                    <button class="btn-buy-plan w-full py-3 px-6 text-sm font-bold rounded-xl bg-purple-500/10 border border-purple-500/30 text-purple-400 hover:bg-purple-500/20 transition cursor-pointer">
                        <i class="fas fa-shopping-cart ml-1"></i> خرید این پلن
                    </button>
                </div>
            </div>

            <button id="close-pricing-modal-btn" class="mt-5 w-full py-3 px-6 text-sm font-bold rounded-xl bg-[var(--primary)]/10 border border-[var(--primary)]/30 text-[var(--primary)] hover:bg-[var(--primary)]/20 transition cursor-pointer">
                <i class="fas fa-times ml-1"></i> بستن
            </button>
        </div>
    </div>

    <script is:inline>
        // Main Application Logic
        document.addEventListener('DOMContentLoaded', () => {
            // Init Particles if available
            if(typeof particlesJS !== 'undefined') {
                particlesJS('particles-js', { "particles": { "number": { "value": 30 }, "color": { "value": "#4c1d95" }, "line_linked": { "color": "#4c1d95", "opacity": 0.2 } } });
            }
        });

        // --- Mobile Menu ---
        const menuBtn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('close-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileOverlay = document.getElementById('mobile-overlay');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        function toggleMenu() {
            if (!mobileMenu) return;
            const isHidden = mobileMenu.classList.contains('translate-x-full');
            if(isHidden) {
                mobileMenu.classList.remove('translate-x-full');
                if(mobileOverlay) {
                    mobileOverlay.classList.remove('opacity-0', 'pointer-events-none');
                    mobileOverlay.classList.add('opacity-100', 'pointer-events-auto');
                }
            } else {
                mobileMenu.classList.add('translate-x-full');
                if(mobileOverlay) {
                    mobileOverlay.classList.add('opacity-0', 'pointer-events-none');
                    mobileOverlay.classList.remove('opacity-100', 'pointer-events-auto');
                }
            }
        }

        if(menuBtn) menuBtn.addEventListener('click', toggleMenu);
        if(closeBtn) closeBtn.addEventListener('click', toggleMenu);
        if(mobileOverlay) mobileOverlay.addEventListener('click', toggleMenu);
        mobileLinks.forEach(l => l.addEventListener('click', toggleMenu));

        // Payment Modal
        const openPaymentBtn = document.getElementById('open-payment-modal');
        const closePaymentBtn = document.getElementById('close-payment-modal');
        const paymentOverlay = document.getElementById('payment-modal-overlay');
        const paymentModal = document.getElementById('payment-modal');
        const paymentContent = document.getElementById('payment-modal-content');

        function openPaymentModal() {
            paymentModal.classList.remove('opacity-0', 'pointer-events-none');
            paymentModal.classList.add('opacity-100', 'pointer-events-auto');
            paymentContent.classList.remove('scale-95');
            paymentContent.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }

        function closePaymentModal() {
            paymentModal.classList.add('opacity-0', 'pointer-events-none');
            paymentModal.classList.remove('opacity-100', 'pointer-events-auto');
            paymentContent.classList.add('scale-95');
            paymentContent.classList.remove('scale-100');
            document.body.style.overflow = '';
        }

        if(openPaymentBtn) openPaymentBtn.addEventListener('click', openPaymentModal);
        if(closePaymentBtn) closePaymentBtn.addEventListener('click', closePaymentModal);
        if(paymentOverlay) paymentOverlay.addEventListener('click', closePaymentModal);

        // Tutorial Modal
        const openTutorialBtn = document.getElementById('open-tutorial-modal');
        const closeTutorialBtn = document.getElementById('close-tutorial-modal');
        const closeTutorialBtn2 = document.getElementById('close-tutorial-modal-btn');
        const tutorialOverlay = document.getElementById('tutorial-modal-overlay');
        const tutorialModal = document.getElementById('tutorial-modal');
        const tutorialContent = document.getElementById('tutorial-modal-content');
        const tutorialTabs = document.querySelectorAll('.tutorial-tab');
        const tutorialContents = document.querySelectorAll('.tutorial-content');

        function openTutorialModal() {
            tutorialModal.classList.remove('opacity-0', 'pointer-events-none');
            tutorialModal.classList.add('opacity-100', 'pointer-events-auto');
            tutorialContent.classList.remove('scale-95');
            tutorialContent.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }

        function closeTutorialModal() {
            tutorialModal.classList.add('opacity-0', 'pointer-events-none');
            tutorialModal.classList.remove('opacity-100', 'pointer-events-auto');
            tutorialContent.classList.add('scale-95');
            tutorialContent.classList.remove('scale-100');
            document.body.style.overflow = '';
        }

        if(openTutorialBtn) openTutorialBtn.addEventListener('click', openTutorialModal);
        if(closeTutorialBtn) closeTutorialBtn.addEventListener('click', closeTutorialModal);
        if(closeTutorialBtn2) closeTutorialBtn2.addEventListener('click', closeTutorialModal);
        if(tutorialOverlay) tutorialOverlay.addEventListener('click', closeTutorialModal);

        // Tutorial Tab Switching
        tutorialTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const device = tab.getAttribute('data-device');
                tutorialTabs.forEach(t => { t.classList.remove('active-tab', 'bg-[var(--secondary)]', 'text-white'); t.classList.add('bg-white/5', 'text-gray-400'); });
                tab.classList.add('active-tab', 'bg-[var(--secondary)]', 'text-white');
                tab.classList.remove('bg-white/5', 'text-gray-400');
                tutorialContents.forEach(c => { c.classList.add('hidden'); if(c.getAttribute('data-device') === device) c.classList.remove('hidden'); });
            });
        });

        // Pricing Modal
        const openPricingBtn = document.getElementById('open-pricing-modal');
        const closePricingBtn = document.getElementById('close-pricing-modal');
        const closePricingBtn2 = document.getElementById('close-pricing-modal-btn');
        const pricingOverlay = document.getElementById('pricing-modal-overlay');
        const pricingModal = document.getElementById('pricing-modal');
        const pricingContent = document.getElementById('pricing-modal-content');
        const pricingTabs = document.querySelectorAll('.pricing-tab');
        const pricingContents = document.querySelectorAll('.pricing-content');

        function openPricingModal() {
            pricingModal.classList.remove('opacity-0', 'pointer-events-none');
            pricingModal.classList.add('opacity-100', 'pointer-events-auto');
            pricingContent.classList.remove('scale-95');
            pricingContent.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }

        function closePricingModal() {
            pricingModal.classList.add('opacity-0', 'pointer-events-none');
            pricingModal.classList.remove('opacity-100', 'pointer-events-auto');
            pricingContent.classList.add('scale-95');
            pricingContent.classList.remove('scale-100');
            document.body.style.overflow = '';
        }

        if(openPricingBtn) openPricingBtn.addEventListener('click', openPricingModal);
        if(closePricingBtn) closePricingBtn.addEventListener('click', closePricingModal);
        if(closePricingBtn2) closePricingBtn2.addEventListener('click', closePricingModal);
        if(pricingOverlay) pricingOverlay.addEventListener('click', closePricingModal);

        // Pricing Tab Switching
        pricingTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const plan = tab.getAttribute('data-plan');
                pricingTabs.forEach(t => { t.classList.remove('active-tab', 'bg-[var(--primary)]', 'text-white'); t.classList.add('bg-white/5', 'text-gray-400'); });
                tab.classList.add('active-tab', 'bg-[var(--primary)]', 'text-white');
                tab.classList.remove('bg-white/5', 'text-gray-400');
                pricingContents.forEach(c => { c.classList.add('hidden'); if(c.getAttribute('data-plan') === plan) c.classList.remove('hidden'); });
            });
        });

        // Buy Plan buttons → open payment modal, close pricing modal
        document.querySelectorAll('.btn-buy-plan').forEach(btn => {
            btn.addEventListener('click', () => {
                closePricingModal();
                setTimeout(openPaymentModal, 300);
            });
        });
    </script>
</body>
</html>
