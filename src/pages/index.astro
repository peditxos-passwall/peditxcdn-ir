                        <div class="w-16 h-16 rounded-full bg-[var(--primary)]/10 flex items-center justify-center text-[var(--primary)] text-2xl mb-6 group-hover:scale-110 transition">
                            <i class="fas fa-tags"></i>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-2">تعرفه‌های سرویس</h3>
